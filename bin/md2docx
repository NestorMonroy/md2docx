#!/usr/bin/env bash
# bin/md2docx - Markdown to DOCX conversion CLI wrapper
#
# This script provides a robust wrapper around the Python conversion pipeline
# with comprehensive validation and error handling.

set -euo pipefail

# =============================================================================
# INITIALIZATION
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# =============================================================================
# LOAD ENVIRONMENT
# =============================================================================

load_environment() {
    if [[ -f "$PROJECT_ROOT/config/variables.sh" ]]; then
        # shellcheck source=/dev/null
        source "$PROJECT_ROOT/config/variables.sh"
    else
        echo "ERROR: Cannot load variables.sh from: $PROJECT_ROOT/config/" >&2
        return 1
    fi

    return 0
}

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
    cat << EOF
Usage: md2docx [OPTIONS] INPUT OUTPUT

Convert Markdown to DOCX using corporate template and styles.

ARGUMENTS:
  INPUT                Input Markdown file path
  OUTPUT               Output DOCX file path

OPTIONS:
  -t, --template PATH  Template DOCX file (default: from config)
  -s, --style PATH     Style configuration YAML (default: from config)
  -i, --images PATH    Images directory (default: from config)
  -v, --verbose        Enable verbose output
  -h, --help           Show this help message

EXAMPLES:
  md2docx input.md output.docx
  md2docx -v docs/report.md builds/report.docx
  md2docx -t custom.docx -s custom.yml input.md output.docx

ENVIRONMENT:
  DOCX_VENV            Python virtualenv path
  DOCX_PYTHON          Python executable path
  DOCX_SCRIPTS_DIR     Python modules directory
  DOCX_TPL             Default template path
  DOCX_STYLE_YML       Default style config path
  DOCX_IMG_DIR         Default images directory

EOF
}

# =============================================================================
# VALIDATION FUNCTIONS
# =============================================================================

validate_environment() {
    local missing=()

    # Check critical environment variables
    if [[ -z "${DOCX_VENV:-}" ]]; then
        missing+=("DOCX_VENV")
    fi

    if [[ -z "${DOCX_PYTHON:-}" ]]; then
        missing+=("DOCX_PYTHON")
    fi

    if [[ -z "${DOCX_SCRIPTS_DIR:-}" ]]; then
        missing+=("DOCX_SCRIPTS_DIR")
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "ERROR: Missing required environment variables: ${missing[*]}" >&2
        return 1
    fi

    # Check Python executable
    if [[ ! -f "$DOCX_PYTHON" ]]; then
        echo "ERROR: Python executable not found: $DOCX_PYTHON" >&2
        echo "ACCION REQUERIDA: Run installation script:" >&2
        echo "  sudo bash scripts/installation/install-docx-stack.sh" >&2
        return 1
    fi

    if [[ ! -x "$DOCX_PYTHON" ]]; then
        echo "ERROR: Python executable is not executable: $DOCX_PYTHON" >&2
        return 1
    fi

    # Check scripts directory
    if [[ ! -d "$DOCX_SCRIPTS_DIR" ]]; then
        echo "ERROR: Scripts directory not found: $DOCX_SCRIPTS_DIR" >&2
        return 1
    fi

    # Check main script
    local main_script="$DOCX_SCRIPTS_DIR/md2docx.py"
    if [[ ! -f "$main_script" ]]; then
        echo "ERROR: Main script not found: $main_script" >&2
        return 1
    fi

    return 0
}

validate_input_file() {
    local input_file="$1"

    if [[ -z "$input_file" ]]; then
        echo "ERROR: Input file not specified" >&2
        return 1
    fi

    if [[ ! -f "$input_file" ]]; then
        echo "ERROR: Input file not found: $input_file" >&2
        return 1
    fi

    if [[ ! -r "$input_file" ]]; then
        echo "ERROR: Input file is not readable: $input_file" >&2
        return 1
    fi

    # Check file is not empty
    if [[ ! -s "$input_file" ]]; then
        echo "ERROR: Input file is empty: $input_file" >&2
        return 1
    fi

    return 0
}

validate_output_path() {
    local output_file="$1"

    if [[ -z "$output_file" ]]; then
        echo "ERROR: Output file not specified" >&2
        return 1
    fi

    local output_dir
    output_dir="$(dirname "$output_file")"

    # Create output directory if it doesn't exist
    if [[ ! -d "$output_dir" ]]; then
        if ! mkdir -p "$output_dir" 2>/dev/null; then
            echo "ERROR: Cannot create output directory: $output_dir" >&2
            return 1
        fi
    fi

    # Check if we can write to output directory
    if [[ ! -w "$output_dir" ]]; then
        echo "ERROR: Output directory is not writable: $output_dir" >&2
        return 1
    fi

    # Warn if output file exists
    if [[ -f "$output_file" ]]; then
        echo "WARNING: Output file exists and will be overwritten: $output_file" >&2
    fi

    return 0
}

validate_template() {
    local template_file="$1"

    if [[ -z "$template_file" ]]; then
        # No template specified, use default or skip
        return 0
    fi

    if [[ ! -f "$template_file" ]]; then
        echo "ERROR: Template file not found: $template_file" >&2
        return 1
    fi

    if [[ ! -r "$template_file" ]]; then
        echo "ERROR: Template file is not readable: $template_file" >&2
        return 1
    fi

    return 0
}

validate_style_config() {
    local style_file="$1"

    if [[ -z "$style_file" ]]; then
        echo "ERROR: Style configuration file not specified" >&2
        return 1
    fi

    if [[ ! -f "$style_file" ]]; then
        echo "ERROR: Style configuration not found: $style_file" >&2
        return 1
    fi

    if [[ ! -r "$style_file" ]]; then
        echo "ERROR: Style configuration is not readable: $style_file" >&2
        return 1
    fi

    # Basic YAML syntax check
    if ! "$DOCX_PYTHON" -c "import yaml; yaml.safe_load(open('$style_file'))" 2>/dev/null; then
        echo "ERROR: Style configuration has invalid YAML syntax: $style_file" >&2
        return 1
    fi

    return 0
}

# =============================================================================
# PARSE ARGUMENTS
# =============================================================================

parse_arguments() {
    INPUT_FILE=""
    OUTPUT_FILE=""
    TEMPLATE_FILE="${DOCX_TPL:-}"
    STYLE_FILE="${DOCX_STYLE_YML:-}"
    IMAGES_DIR="${DOCX_IMG_DIR:-}"
    VERBOSE=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_usage
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -t|--template)
                if [[ -z "${2:-}" ]]; then
                    echo "ERROR: --template requires an argument" >&2
                    exit 1
                fi
                TEMPLATE_FILE="$2"
                shift 2
                ;;
            -s|--style)
                if [[ -z "${2:-}" ]]; then
                    echo "ERROR: --style requires an argument" >&2
                    exit 1
                fi
                STYLE_FILE="$2"
                shift 2
                ;;
            -i|--images)
                if [[ -z "${2:-}" ]]; then
                    echo "ERROR: --images requires an argument" >&2
                    exit 1
                fi
                IMAGES_DIR="$2"
                shift 2
                ;;
            -*)
                echo "ERROR: Unknown option: $1" >&2
                show_usage >&2
                exit 1
                ;;
            *)
                if [[ -z "$INPUT_FILE" ]]; then
                    INPUT_FILE="$1"
                elif [[ -z "$OUTPUT_FILE" ]]; then
                    OUTPUT_FILE="$1"
                else
                    echo "ERROR: Too many arguments" >&2
                    show_usage >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done

    # Check required arguments
    if [[ -z "$INPUT_FILE" ]] || [[ -z "$OUTPUT_FILE" ]]; then
        echo "ERROR: INPUT and OUTPUT arguments are required" >&2
        show_usage >&2
        exit 1
    fi
}

# =============================================================================
# MAIN CONVERSION FUNCTION
# =============================================================================

convert_document() {
    local python_args=(
        "--input" "$INPUT_FILE"
        "--output" "$OUTPUT_FILE"
        "--style" "$STYLE_FILE"
    )

    # Add template if specified
    if [[ -n "$TEMPLATE_FILE" ]]; then
        python_args+=("--template" "$TEMPLATE_FILE")
    fi

    # Add verbose flag
    if [[ "$VERBOSE" == "true" ]]; then
        python_args+=("--verbose")
    fi

    # Set PYTHONPATH to include scripts directory
    export PYTHONPATH="$PROJECT_ROOT:${PYTHONPATH:-}"

    # Run Python conversion
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[INFO] Running conversion..."
        echo "[INFO] Python: $DOCX_PYTHON"
        echo "[INFO] Command: python -m mdx.md2docx ${python_args[*]}"
    fi

    if ! "$DOCX_PYTHON" -m mdx.md2docx "${python_args[@]}"; then
        echo "ERROR: Conversion failed" >&2
        return 1
    fi

    return 0
}

# =============================================================================
# MAIN EXECUTION
# =============================================================================

main() {
    # Load environment
    if ! load_environment; then
        echo "ERROR: Failed to load environment" >&2
        exit 1
    fi

    # Parse arguments
    parse_arguments "$@"

    # Validate environment
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[INFO] Validating environment..."
    fi

    if ! validate_environment; then
        exit 1
    fi

    # Validate inputs
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[INFO] Validating inputs..."
    fi

    if ! validate_input_file "$INPUT_FILE"; then
        exit 1
    fi

    if ! validate_output_path "$OUTPUT_FILE"; then
        exit 1
    fi

    if ! validate_template "$TEMPLATE_FILE"; then
        exit 1
    fi

    if ! validate_style_config "$STYLE_FILE"; then
        exit 1
    fi

    # Show configuration
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[INFO] Configuration:"
        echo "  Input:    $INPUT_FILE"
        echo "  Output:   $OUTPUT_FILE"
        echo "  Template: ${TEMPLATE_FILE:-none}"
        echo "  Style:    $STYLE_FILE"
        echo "  Images:   ${IMAGES_DIR:-none}"
        echo ""
    fi

    # Convert document
    if ! convert_document; then
        exit 1
    fi

    # Verify output was created
    if [[ ! -f "$OUTPUT_FILE" ]]; then
        echo "ERROR: Output file was not created: $OUTPUT_FILE" >&2
        exit 1
    fi

    # Check output file size
    local file_size
    file_size=$(stat -f%z "$OUTPUT_FILE" 2>/dev/null || stat -c%s "$OUTPUT_FILE" 2>/dev/null || echo "0")

    if [[ "$file_size" -lt 1000 ]]; then
        echo "WARNING: Output file is suspiciously small: $file_size bytes" >&2
    fi

    if [[ "$VERBOSE" == "true" ]]; then
        echo "[SUCCESS] Conversion completed"
        echo "  Output: $OUTPUT_FILE"
        echo "  Size:   $((file_size / 1024)) KB"
    else
        echo "[SUCCESS] $OUTPUT_FILE"
    fi

    return 0
}

# Execute main function
main "$@"
exit $?